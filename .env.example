# 皮皮 · 环境变量示例
# 复制为 .env 或用 export 直接设置。
# 规则：前缀 PIPI_ + 双下划线 __ 表示层级。
# 例：PIPI_LLM__API_KEY  →  config["llm"]["api_key"]

# ---------------- LLM（对话大脑，全云端方案）----------------
# 不填 API Key 则自动降级为 MockLLM（规则回复），系统照样能跑
PIPI_LLM__API_KEY=
PIPI_LLM__PROVIDER=qwen
PIPI_LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PIPI_LLM__MODEL=qwen3-flash
PIPI_LLM__CHEAP_MODEL=qwen3-flash

# 备选一：DeepSeek（降级链第二顺位，价格屠夫，缓存命中 ¥0.02/百万）
# PIPI_LLM__PROVIDER=deepseek
# PIPI_LLM__BASE_URL=https://api.deepseek.com/v1
# PIPI_LLM__MODEL=deepseek-chat

# 备选二：豆包（中文"人话感"最强，语音生态最完整；拟人度实测最佳）
# PIPI_LLM__PROVIDER=doubao
# PIPI_LLM__BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# PIPI_LLM__MODEL=doubao-seed-2.1-pro

# 备选三：Moonshot (Kimi)
# PIPI_LLM__PROVIDER=moonshot
# PIPI_LLM__BASE_URL=https://api.moonshot.cn/v1
# PIPI_LLM__MODEL=moonshot-v1-8k

# ---------------- 人格 ----------------
PIPI_PERSONA__ACTIVE=tsundere

# ---------------- 云 ASR（SenseVoice 不可用时的备选）----------------
PIPI_AUDIO__ASR__CLOUD_DASHSCOPE__API_KEY=

# ---------------- 语音合成（TTS）----------------
# 豆包 TTS 2.0（默认首选；留空则降级 edge_tts → mock）
PIPI_AUDIO__TTS__ARK_TTS__API_KEY=
# 可选：端到端实时语音（S2S，需先在 default.yaml 打开 audio.realtime.enabled）
# PIPI_AUDIO__REALTIME__APP_ID=
# PIPI_AUDIO__REALTIME__ACCESS_TOKEN=

# ---------------- 隐私开关 ----------------
# 摄像头整体关闭
# PIPI_VISION__ENABLED=false
# 原始画面绝不落盘（默认就是 false）
# PIPI_VISION__PRIVACY__SAVE_FRAMES=false
# 关闭记忆删除（不推荐）
# PIPI_MEMORY__ALLOW_USER_FORGET=false

# ---------------- 主动搭话 ----------------
# 每日上限由人格决定；这里可以强制覆盖 idle 阈值
# PIPI_PROACTIVE__IDLE_HOURS=2.0

# ---------------- 硬件 ----------------
# PIPI_MOTION__ENABLED=true
# PIPI_MOTION__PROVIDER=esp32
# PIPI_MOTION__ESP32__PORT=/dev/ttyUSB0
